<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- Godot 4 game assembly. Godot.NET.Sdk is the outer SDK: it brings the GodotSharp bindings,
       the Godot source generators and the .godot/mono/temp output layout, and it imports
       Microsoft.NET.Sdk itself. ktsu.Sdk.Godot layers the ktsu conventions on top and puts back
       the two properties the core SDK would otherwise overwrite. Named {Solution}.Godot so the
       core SDK detects the project type.

       The engine SDK version is pinned here rather than in global.json because it tracks the
       Godot editor version, which is a per-project choice. -->
  <Sdk Name="ktsu.Sdk" />
  <Sdk Name="ktsu.Sdk.Godot" />
  <ItemGroup>
    <!-- Standard packages required by KTSU0001 for non-test projects. -->
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
</Project>
