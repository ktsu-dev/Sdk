<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lives under a scaffolding "examples" folder, one level below the solution. Regression
       fixture for ktsu-dev/Sdk#37: the folder segment must not leak into the derived namespace,
       assembly name, or package ID. Pinned to net10.0 to keep evaluation single-valued. -->
  <Sdk Name="ktsu.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Standard packages required by KTSU0001 for non-test projects. -->
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
</Project>
