<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sits directly under the solution, in a folder whose name merely contains "test" as a
       substring. Control fixture for ktsu-dev/Sdk#37: the scaffolding strip must match a whole
       path segment, not any segment containing one of the scaffolding words. Pinned to net10.0 to
       keep evaluation single-valued. -->
  <Sdk Name="ktsu.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Standard packages required by KTSU0001 for non-test projects. -->
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
</Project>
