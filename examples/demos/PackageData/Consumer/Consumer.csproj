<Project Sdk="Microsoft.NET.Sdk">
  <!-- Publishes an app whose graph contains two ktsu-SDK projects. Before the package-data fix
       this failed with NETSDK1152: both projects copied their metadata files to the same
       relative output path. -->
  <Sdk Name="ktsu.Sdk" />
  <Sdk Name="ktsu.Sdk.ConsoleApp" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <ProjectReference Include="../Beta/Beta.csproj" />
  </ItemGroup>
</Project>
