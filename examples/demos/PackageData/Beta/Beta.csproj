<Project Sdk="Microsoft.NET.Sdk">
  <!-- A second packable library referencing the first. Two ktsu-SDK projects in one publish
       graph is the shape that reproduced NETSDK1152. -->
  <Sdk Name="ktsu.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <ProjectReference Include="../Alpha/Alpha.csproj" />
  </ItemGroup>
</Project>
