<Project Sdk="Microsoft.NET.Sdk">
  <!-- KTSU0004 must not fire for a == null guard that binds to a user-defined operator ==. -->
  <Sdk Name="ktsu.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <!-- CA1510 makes the same mistake KTSU0004 used to: it suggests ThrowIfNull, a reference check,
         for a guard that calls a user-defined operator ==. It is not this SDK's rule, and Unity
         projects target netstandard2.1, where CA1510 does not apply. -->
    <NoWarn>$(NoWarn);CA1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
</Project>
