<!-- ktsu.Sdk/Sdk.targets -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Syncs consumer style/config files from the packaged SDK defaults.
       The destinations live at the solution root, but this target runs once per inner
       build (per TargetFramework) and per project, so many MSBuild nodes race for the
       same handful of files. Two things keep that safe:
         - The desired content is computed first and compared against what is already on
           disk, so a synced file is never rewritten. Steady-state builds do reads only.
         - The rare real write is serialized across processes by a named mutex scoped to
           the solution directory, with a bounded retry as a fallback for hosts where a
           named mutex cannot be created. -->
  <UsingTask TaskName="KtsuSyncStyleConfigFiles"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <SyncScope ParameterType="System.String" Required="true" />
      <CopyrightText ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Threading" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs"><![CDATA[
const string headerKey = "file_header_template";

string consumerHeader = null;
if (!string.IsNullOrWhiteSpace(CopyrightText))
{
    consumerHeader = headerKey + " = " + CopyrightText
        .Replace("\r\n", "\n")
        .Replace("\r", "\n")
        .Replace("\n", "\\n");
}

// A stable, path-derived mutex name. Distinct solutions get distinct locks; a
// truncated collision would only over-serialize, which is harmless here.
char[] scopeChars = (SyncScope ?? string.Empty).ToLowerInvariant().ToCharArray();
for (int i = 0; i < scopeChars.Length; i++)
{
    if (!char.IsLetterOrDigit(scopeChars[i]))
    {
        scopeChars[i] = '_';
    }
}
string scopeKey = new string(scopeChars);
if (scopeKey.Length > 180)
{
    scopeKey = scopeKey.Substring(scopeKey.Length - 180);
}

UTF8Encoding encoding = new UTF8Encoding(false);
Mutex mutex = null;
bool held = false;
try
{
    try
    {
        mutex = new Mutex(false, "Global\\ktsu-sdk-style-sync-" + scopeKey);
        held = mutex.WaitOne(TimeSpan.FromSeconds(120));
    }
    catch (AbandonedMutexException)
    {
        // A node died holding the lock; the files are still consistent because every
        // write is a whole-file write, so take ownership and carry on.
        held = true;
    }
    catch (Exception lockException)
    {
        Log.LogMessage(MessageImportance.Low, "ktsu.Sdk: style config sync lock unavailable ({0}); relying on retries.", lockException.Message);
    }

    foreach (ITaskItem item in SourceFiles)
    {
        string source = item.GetMetadata("FullPath");
        string destination = item.GetMetadata("Destination");
        if (string.IsNullOrEmpty(destination) || !File.Exists(source) || !File.Exists(destination))
        {
            continue;
        }

        string desired = File.ReadAllText(source);
        if (consumerHeader != null && string.Equals(item.GetMetadata("RewriteHeader"), "true", StringComparison.OrdinalIgnoreCase))
        {
            // Replace the whole file_header_template line wherever it appears, rather than
            // matching a known default value: the packaged default is free to change, and a
            // value-based match silently leaves a stale header behind when it does.
            StringBuilder builder = new StringBuilder(desired.Length);
            int cursor = 0;
            while (cursor < desired.Length)
            {
                int lineFeed = desired.IndexOf('\n', cursor);
                int next = lineFeed < 0 ? desired.Length : lineFeed + 1;
                string line = desired.Substring(cursor, next - cursor);
                cursor = next;

                string body = line.TrimEnd('\r', '\n');
                string terminator = line.Substring(body.Length);
                string keyed = body.TrimStart();
                string remainder = keyed.StartsWith(headerKey, StringComparison.OrdinalIgnoreCase)
                    ? keyed.Substring(headerKey.Length).TrimStart()
                    : null;

                if (remainder != null && remainder.StartsWith("=", StringComparison.Ordinal))
                {
                    builder.Append(body.Substring(0, body.Length - keyed.Length)).Append(consumerHeader).Append(terminator);
                }
                else
                {
                    builder.Append(line);
                }
            }

            desired = builder.ToString();
        }

        for (int attempt = 0; attempt < 5; attempt++)
        {
            try
            {
                if (string.Equals(File.ReadAllText(destination), desired, StringComparison.Ordinal))
                {
                    break;
                }

                File.WriteAllText(destination, desired, encoding);
                Log.LogMessage(MessageImportance.Low, "ktsu.Sdk: synced {0} from SDK defaults.", destination);
                break;
            }
            catch (IOException) when (attempt < 4)
            {
                Thread.Sleep(100 * (attempt + 1));
            }
            catch (UnauthorizedAccessException) when (attempt < 4)
            {
                Thread.Sleep(100 * (attempt + 1));
            }
            catch (Exception syncException)
            {
                // Never fail a build over a style file that another node is mid-write on.
                Log.LogMessage(MessageImportance.Low, "ktsu.Sdk: could not sync {0} ({1}).", destination, syncException.Message);
                break;
            }
        }
    }
}
finally
{
    if (mutex != null)
    {
        if (held)
        {
            mutex.ReleaseMutex();
        }

        mutex.Dispose();
    }
}

// No explicit return: RoslynCodeTaskFactory closes a Fragment with its own
// `return !Log.HasLoggedErrors;`, so a `return true;` here would make that
// generated statement unreachable (CS0162) in every consumer build.
      ]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <IsPrerelease>false</IsPrerelease>
    <IsPrerelease Condition="'$(Version)' != '' And $(Version.Contains('-'))">true</IsPrerelease>

    <IsExecutable>false</IsExecutable>
    <IsExecutable Condition="$(OutputType) == 'Exe' Or $(OutputType) == 'WinExe'">true</IsExecutable>

    <IsLibrary>false</IsLibrary>
    <IsLibrary Condition="$(OutputType) == 'Library' And !$(IsTestProject)">true</IsLibrary>

    <IsPublishable Condition="$(IsExecutable)">true</IsPublishable>
    <IsPackable Condition="'$(IsLibrary)' == 'true' Or '$(PackAsTool)' == 'true'">true</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="$(IsTestProject) == 'true'">
    <NoWarn>$(NoWarn);CS1591;CA2225;IDE0022;IDE0058;CA1305;CA5394;CA1707;</NoWarn>
    <!-- CS1591: Missing XML comment for publicly visible type or member -->
    <!-- CA2225: Operator overloads have named alternates -->
    <!-- IDE0022: Use expression body for methods -->
    <!-- IDE0058: Expression value is never used -->
    <!-- CA1305: Specify IFormatProvider -->
    <!-- CA5394: Do not use insecure randomness -->
    <!-- CA1707: Identifiers should not contain underscores -->
  </PropertyGroup>

  <!-- Collect package references for analyzer validation.
       Must run before GenerateMSBuildEditorConfigFileCore: that inner target (a
       DependsOnTarget of GenerateMSBuildEditorConfigFile) snapshots the
       CompilerVisibleProperty values into the generated editorconfig. Hooking the
       outer GenerateMSBuildEditorConfigFile target runs after its dependencies have
       already executed, so the Has* values would still be empty at snapshot time. -->
  <Target Name="SetPackageReferenceProperties" BeforeTargets="GenerateMSBuildEditorConfigFileCore">
    <ItemGroup>
      <_Polyfill Include="@(PackageReference)" Condition="'%(Identity)' == 'Polyfill'" />
      <_SystemMemory Include="@(PackageReference)" Condition="'%(Identity)' == 'System.Memory'" />
      <_SystemThreadingTasksExtensions Include="@(PackageReference)" Condition="'%(Identity)' == 'System.Threading.Tasks.Extensions'" />
    </ItemGroup>
    <PropertyGroup>
      <HasPolyfill Condition="'@(_Polyfill)' != ''">true</HasPolyfill>
      <HasPolyfill Condition="'@(_Polyfill)' == ''">false</HasPolyfill>

      <HasSystemMemory Condition="'@(_SystemMemory)' != ''">true</HasSystemMemory>
      <HasSystemMemory Condition="'@(_SystemMemory)' == ''">false</HasSystemMemory>

      <HasSystemThreadingTasksExtensions Condition="'@(_SystemThreadingTasksExtensions)' != ''">true</HasSystemThreadingTasksExtensions>
      <HasSystemThreadingTasksExtensions Condition="'@(_SystemThreadingTasksExtensions)' == ''">false</HasSystemThreadingTasksExtensions>

      <!-- KTSU0007: the PrivateAssets metadata of the Polyfill reference. Metadata does not reach
           the compilation references, so the analyzer reads the evaluated value from here. This
           covers both the attribute and the child-element spelling. -->
      <PolyfillPrivateAssets>@(_Polyfill->'%(PrivateAssets)')</PolyfillPrivateAssets>
    </PropertyGroup>
  </Target>

  <!-- Make SDK-computed properties visible to analyzers -->
  <ItemGroup>
    <CompilerVisibleProperty Include="IsTestProject" />
    <CompilerVisibleProperty Include="TestProjectExists" />
    <CompilerVisibleProperty Include="TestProjectNamespace" />
    <CompilerVisibleProperty Include="TargetFramework" />
    <CompilerVisibleProperty Include="TargetFrameworkIdentifier" />
    <CompilerVisibleProperty Include="HasPolyfill" />
    <CompilerVisibleProperty Include="HasSystemMemory" />
    <CompilerVisibleProperty Include="HasSystemThreadingTasksExtensions" />
    <CompilerVisibleProperty Include="PolyfillPrivateAssets" />
    <CompilerVisibleProperty Include="ManagePackageVersionsCentrally" />
  </ItemGroup>

  <!-- The project file is supplied to analyzers so the KTSU0006 and KTSU0007 fixers can edit it.
       It lives here rather than inside either analyzer's input target so that disabling one
       analyzer does not take the other's code fix with it. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <AdditionalFiles Include="$(MSBuildProjectFullPath)" />
  </ItemGroup>

  <!-- ================================================================= -->
  <!-- KTSU0005 / KTSU0006: generate analyzer input files                -->
  <!-- These targets gather package-graph facts that a per-project       -->
  <!-- Roslyn analyzer cannot otherwise observe, and surface them as     -->
  <!-- additional files (and the project/props XML the fixers edit).     -->
  <!-- ================================================================= -->
  <PropertyGroup>
    <!-- Opt-out switches for the package-hygiene analyzers -->
    <KtsuEnableOrphanedPackageVersionAnalysis Condition="'$(KtsuEnableOrphanedPackageVersionAnalysis)' == ''">true</KtsuEnableOrphanedPackageVersionAnalysis>
    <KtsuEnableTransitivePackageAnalysis Condition="'$(KtsuEnableTransitivePackageAnalysis)' == ''">true</KtsuEnableTransitivePackageAnalysis>

    <_KtsuOrphanedPackageVersionsFile>$(IntermediateOutputPath)ktsu.orphaned-packageversions.g.txt</_KtsuOrphanedPackageVersionsFile>
    <_KtsuTransitivePackageMapFile>$(IntermediateOutputPath)ktsu.transitive-package-map.g.txt</_KtsuTransitivePackageMapFile>
    <_KtsuDirectPackagesFile>$(IntermediateOutputPath)ktsu.direct-packages.g.txt</_KtsuDirectPackagesFile>
  </PropertyGroup>

  <!-- KTSU0005 ignore list: PackageVersion identifiers that must never be reported as orphans,
       even when no project carries a matching PackageReference. These are SDK-governed build-time
       packages (the SDK requires them via KTSU0001 and/or they are injected by another SDK into a
       project this scan cannot observe - e.g. MSTest.Sdk injects the Microsoft.Testing.Extensions.*
       runner packages into test projects, which KTSU0005 deliberately skips). Consumers can extend
       this with <KtsuOrphanedPackageVersionIgnore Include="..." /> in their own project. The
       Microsoft.Testing.Extensions.* runner family is matched by prefix below. -->
  <ItemGroup>
    <KtsuOrphanedPackageVersionIgnore Include="Polyfill" />
    <KtsuOrphanedPackageVersionIgnore Include="System.Memory" />
    <KtsuOrphanedPackageVersionIgnore Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>

  <!-- KTSU0005: compute solution-wide orphaned PackageVersion entries -->
  <Target Name="_KtsuGenerateOrphanedPackageVersionInputs"
          Condition="'$(KtsuEnableOrphanedPackageVersionAnalysis)' == 'true' And '$(IsTestProject)' != 'true' And '$(ManagePackageVersionsCentrally)' == 'true' And Exists('$(DirectoryPackagesPropsFilePath)')"
          BeforeTargets="CoreCompile">

    <!-- All package identifiers referenced by any project / Directory.Build file in the solution.
         XmlPeek is used because sibling projects are not otherwise visible to this build. -->
    <!-- EnsureTrailingSlash: when the SDK computes SolutionDir itself (e.g. a CI `dotnet build`
         of a bare project, where MSBuild does not provide a slash-terminated SolutionDir) the value
         has no trailing separator. Without it `$(SolutionDir)**\*.csproj` is a malformed glob that
         matches nothing, so sibling projects go unseen and their referenced packages are falsely
         reported as orphans. -->
    <PropertyGroup>
      <_KtsuSolutionDirSlash>$([MSBuild]::EnsureTrailingSlash('$(SolutionDir)'))</_KtsuSolutionDirSlash>
    </PropertyGroup>
    <ItemGroup>
      <_KtsuPackageDeclaringFile Include="$(_KtsuSolutionDirSlash)**\*.csproj" />
      <_KtsuPackageDeclaringFile Include="$(_KtsuSolutionDirSlash)**\Directory.Build.props" />
      <_KtsuPackageDeclaringFile Include="$(_KtsuSolutionDirSlash)**\Directory.Build.targets" />
      <_KtsuPackageDeclaringFile Include="$(DirectoryPackagesPropsFilePath)" />
    </ItemGroup>

    <XmlPeek XmlInputPath="%(_KtsuPackageDeclaringFile.Identity)"
             Query="//*[local-name()='PackageReference']/@Include"
             Condition="Exists('%(_KtsuPackageDeclaringFile.Identity)')"
             ContinueOnError="WarnAndContinue">
      <Output TaskParameter="Result" ItemName="_KtsuReferencedPackages" />
    </XmlPeek>

    <XmlPeek XmlInputPath="%(_KtsuPackageDeclaringFile.Identity)"
             Query="//*[local-name()='GlobalPackageReference']/@Include"
             Condition="Exists('%(_KtsuPackageDeclaringFile.Identity)')"
             ContinueOnError="WarnAndContinue">
      <Output TaskParameter="Result" ItemName="_KtsuReferencedPackages" />
    </XmlPeek>

    <!-- Include the fully-evaluated references for the current project (covers SDK-injected refs). -->
    <ItemGroup>
      <_KtsuReferencedPackages Include="@(PackageReference)" />
      <_KtsuReferencedPackages Include="@(GlobalPackageReference)" />
    </ItemGroup>

    <!-- All centrally-managed PackageVersion identifiers. -->
    <XmlPeek XmlInputPath="$(DirectoryPackagesPropsFilePath)"
             Query="//*[local-name()='PackageVersion']/@Include"
             ContinueOnError="WarnAndContinue">
      <Output TaskParameter="Result" ItemName="_KtsuAllPackageVersions" />
    </XmlPeek>

    <!-- Orphans = declared versions not referenced anywhere (case-insensitive identity match),
         minus the SDK-governed ignore list (exact ids and family prefixes). -->
    <ItemGroup>
      <_KtsuOrphanedPackageVersions Include="@(_KtsuAllPackageVersions)" Exclude="@(_KtsuReferencedPackages)" />
      <_KtsuOrphanedPackageVersions Remove="@(KtsuOrphanedPackageVersionIgnore)" />
      <_KtsuOrphanedPackageVersions Remove="@(_KtsuOrphanedPackageVersions)"
                                    Condition="$([System.String]::new('%(Identity)').StartsWith('Microsoft.Testing.Extensions.'))" />
    </ItemGroup>

    <WriteLinesToFile File="$(_KtsuOrphanedPackageVersionsFile)"
                      Lines="@(_KtsuOrphanedPackageVersions)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <FileWrites Include="$(_KtsuOrphanedPackageVersionsFile)" />
      <AdditionalFiles Include="$(_KtsuOrphanedPackageVersionsFile)" />
      <AdditionalFiles Include="$(DirectoryPackagesPropsFilePath)" />
    </ItemGroup>
  </Target>

  <!-- KTSU0006: map package-provided assemblies to their packages, and the direct reference set -->
  <Target Name="_KtsuGenerateTransitivePackageInputs"
          Condition="'$(KtsuEnableTransitivePackageAnalysis)' == 'true' And '$(IsTestProject)' != 'true'"
          DependsOnTargets="ResolveReferences"
          BeforeTargets="CoreCompile">

    <ItemGroup>
      <_KtsuPackageAssembly Include="@(ResolvedCompileFileDefinitions)"
                            Condition="'%(ResolvedCompileFileDefinitions.NuGetPackageId)' != ''" />
      <_KtsuAssemblyMapLine Include="@(_KtsuPackageAssembly->'%(FileName)|%(NuGetPackageId)|%(NuGetPackageVersion)')" />

      <_KtsuDirectPackage Include="@(PackageReference)" />
      <_KtsuDirectPackage Include="@(GlobalPackageReference)" />
    </ItemGroup>

    <WriteLinesToFile File="$(_KtsuTransitivePackageMapFile)"
                      Lines="@(_KtsuAssemblyMapLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(_KtsuDirectPackagesFile)"
                      Lines="@(_KtsuDirectPackage)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <FileWrites Include="$(_KtsuTransitivePackageMapFile)" />
      <FileWrites Include="$(_KtsuDirectPackagesFile)" />
      <AdditionalFiles Include="$(_KtsuTransitivePackageMapFile)" />
      <AdditionalFiles Include="$(_KtsuDirectPackagesFile)" />
    </ItemGroup>
  </Target>

  <!-- Analyzer package - automatically included to enforce other requirements -->
  <ItemGroup>
    <PackageReference Include="ktsu.Sdk.Analyzers" VersionOverride="{version}" Condition="$(IsTestProject) == 'false'">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Configure Polyfill source generators for non-test projects -->
  <PropertyGroup Condition="$(IsTestProject) == 'false'">
    <PolyEnsure>true</PolyEnsure>
    <PolyNullability>true</PolyNullability>
    <PolyArgumentExceptions>true</PolyArgumentExceptions>
    <PolyStringInterpolation>true</PolyStringInterpolation>
  </PropertyGroup>

  <!-- Keep consumer repository style/config files aligned with the SDK package defaults.
       Opt out with <KtsuSyncStyleConfigFiles>false</KtsuSyncStyleConfigFiles>. -->
  <PropertyGroup>
    <KtsuSyncStyleConfigFiles Condition="'$(KtsuSyncStyleConfigFiles)' == ''">true</KtsuSyncStyleConfigFiles>
    <_KtsuPackageDataDir>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\_PackageData'))</_KtsuPackageDataDir>
  </PropertyGroup>

  <Target Name="_KtsuSyncStyleConfigFiles"
          Condition="'$(KtsuSyncStyleConfigFiles)' == 'true' And '$(DesignTimeBuild)' != 'true' And Exists('$(_KtsuPackageDataDir)')"
          BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_KtsuStyleConfigFile Include="$(_KtsuPackageDataDir)\editorconfig" Condition="Exists('$(_KtsuPackageDataDir)\editorconfig') And Exists('$(SolutionDir)\.editorconfig')">
        <Destination>$(SolutionDir)\.editorconfig</Destination>
        <RewriteHeader>true</RewriteHeader>
      </_KtsuStyleConfigFile>
      <_KtsuStyleConfigFile Include="$(_KtsuPackageDataDir)\gitattributes" Condition="Exists('$(_KtsuPackageDataDir)\gitattributes') And Exists('$(SolutionDir)\.gitattributes')">
        <Destination>$(SolutionDir)\.gitattributes</Destination>
      </_KtsuStyleConfigFile>
      <_KtsuStyleConfigFile Include="$(_KtsuPackageDataDir)\gitignore" Condition="Exists('$(_KtsuPackageDataDir)\gitignore') And Exists('$(SolutionDir)\.gitignore')">
        <Destination>$(SolutionDir)\.gitignore</Destination>
      </_KtsuStyleConfigFile>
      <_KtsuStyleConfigFile Include="$(_KtsuPackageDataDir)\runsettings" Condition="Exists('$(_KtsuPackageDataDir)\runsettings') And Exists('$(SolutionDir)\.runsettings')">
        <Destination>$(SolutionDir)\.runsettings</Destination>
      </_KtsuStyleConfigFile>
    </ItemGroup>

    <KtsuSyncStyleConfigFiles SourceFiles="@(_KtsuStyleConfigFile)"
                              SyncScope="$(SolutionDir)"
                              CopyrightText="$(Copyright)"
                              Condition="'@(_KtsuStyleConfigFile)' != ''" />
  </Target>

  <!-- Add package data to the package -->
  <ItemGroup Condition="$(IsTestProject) == 'false'">
    <None Include="$(AuthorsFilePath)" Condition="Exists('$(AuthorsFilePath)')" Pack="true" PackagePath="\" Link="_PackageData\$(AuthorsFileName)" CopyToOutputDirectory="Always" />
    <None Include="$(AuthorsUrlFilePath)" Condition="Exists('$(AuthorsUrlFilePath)')" Pack="true" PackagePath="\" Link="_PackageData\$(AuthorsUrlFileName)" CopyToOutputDirectory="Always" />
    <None Include="$(ProjectUrlFilePath)" Condition="Exists('$(ProjectUrlFilePath)')" Pack="true" PackagePath="\" Link="_PackageData\$(ProjectUrlFileName)" CopyToOutputDirectory="Always" />
    <None Include="$(DescriptionFilePath)" Condition="Exists('$(DescriptionFilePath)')" Pack="true" PackagePath="\" Link="_PackageData\$(DescriptionFileName)" CopyToOutputDirectory="Always" />
    <None Include="$(TagsFilePath)" Condition="Exists('$(TagsFilePath)')" Pack="true" PackagePath="\" Link="_PackageData\$(TagsFileName)" CopyToOutputDirectory="Always" />
    <None Include="$(LicenseFilePath)" Condition="Exists('$(LicenseFilePath)')" Pack="true" PackagePath="\" Link="_PackageData\$(LicenseFileName)" CopyToOutputDirectory="Always" />
    <None Include="$(ChangelogFilePath)" Condition="Exists('$(ChangelogFilePath)')" Pack="true" PackagePath="\" Link="_PackageData\$(ChangelogFileName)" CopyToOutputDirectory="Always" />
    <None Include="$(ReadmeFilePath)" Condition="Exists('$(ReadmeFilePath)')" Pack="true" PackagePath="\" Link="_PackageData\$(ReadmeFileName)" CopyToOutputDirectory="Always" />
    <None Include="$(VersionFilePath)" Condition="Exists('$(VersionFilePath)')" Pack="true" PackagePath="\" Link="_PackageData\$(VersionFileName)" CopyToOutputDirectory="Always" />
    <None Include="$(IconFilePath)" Condition="Exists('$(IconFilePath)')" Pack="true" PackagePath="\" Link="_PackageData\$(IconFileName)" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- ================================================================= -->
  <!-- Silence the spurious "Source control information is not available" -->
  <!-- warning caused by a transitively-leaked SourceLink reference.      -->
  <!--                                                                    -->
  <!-- Since .NET 8 the SDK bundles SourceLink and imports it implicitly  -->
  <!-- (no package reference), which tells the SourceLink/Git tasks to    -->
  <!-- stay quiet when source control info is unavailable - the warning   -->
  <!-- is gated on Pkg<id> being empty (the "imported from an SDK without -->
  <!-- a package reference" case). Older ktsu.* libraries (built before   -->
  <!-- ktsu.Sdk v2.11.0 removed SourceLink) referenced                    -->
  <!-- Microsoft.SourceLink.GitHub / .AzureRepos.Git WITHOUT              -->
  <!-- PrivateAssets="all", so SourceLink leaks transitively into every   -->
  <!-- downstream consumer. The leak sets PkgMicrosoft_SourceLink_Common  -->
  <!-- (via the newer packages' buildTransitive props), which both        -->
  <!-- disables the bundled SDK's graceful silence AND re-arms the        -->
  <!-- warning for any build where git info isn't resolved.               -->
  <!--                                                                    -->
  <!-- We clear those Pkg<id> properties immediately before the tasks     -->
  <!-- read them, restoring the bundled-SDK "no-warn" behaviour. The      -->
  <!-- SourceLink task assemblies are resolved statically at import time  -->
  <!-- (via *AssemblyFile properties), so emptying these here only flips  -->
  <!-- the NoWarnOnMissing* gate - SourceLink still generates a source    -->
  <!-- link whenever source control IS available (e.g. in CI).            -->
  <!--                                                                    -->
  <!-- Opt out with <KtsuSuppressLeakedSourceLinkWarning>false</...>.     -->
  <!-- ================================================================= -->
  <PropertyGroup>
    <KtsuSuppressLeakedSourceLinkWarning Condition="'$(KtsuSuppressLeakedSourceLinkWarning)' == ''">true</KtsuSuppressLeakedSourceLinkWarning>
  </PropertyGroup>

  <Target Name="_KtsuSuppressLeakedSourceLinkWarning"
          Condition="'$(KtsuSuppressLeakedSourceLinkWarning)' == 'true'"
          BeforeTargets="InitializeSourceControlInformationFromSourceControlManager;_GenerateSourceLinkFile">
    <PropertyGroup>
      <PkgMicrosoft_Build_Tasks_Git />
      <PkgMicrosoft_SourceLink_Common />
    </PropertyGroup>
  </Target>
</Project>
