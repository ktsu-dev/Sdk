<!-- ktsu.Sdk.Tool/Sdk.targets -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Catches a consumer re-declaring TargetFrameworks in their own PropertyGroup, which wins
       over Sdk.props and would silently produce a package with no usable tools/ payload. -->
  <Target Name="_KtsuValidateToolTargetFramework" BeforeTargets="Build;Pack">
    <Error Condition="'$(TargetFrameworks)' != ''"
           Code="KTSU1001"
           Text="ktsu.Sdk.Tool requires a single TargetFramework, but TargetFrameworks is set to '$(TargetFrameworks)'. A dotnet tool package cannot multi-target. Remove TargetFrameworks, or set TargetFramework to override the default." />
  </Target>
</Project>
