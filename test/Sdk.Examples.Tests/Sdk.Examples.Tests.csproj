<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests for the ktsu.Sdk MSBuild SDKs.

    This project deliberately uses the plain Microsoft.NET.Sdk (NOT ktsu.Sdk) so it can be
    restored and built from nuget.org without first bootstrapping the local SDK packages.
    The tests themselves pack the ktsu.Sdk packages to a temporary feed and then build the
    example projects under /examples against that feed, asserting on the results.

    It is intentionally kept out of Sdk.sln so the main build/release pipeline does not try
    to consume the (not-yet-published) SDK. A dedicated CI job runs `dotnet test` here.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- These are end-to-end build tests; building all the sample SDKs is the point. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <!--
      Roslyn, at the version the analyzer is built against, so analyzers and code fixes can be run
      in-process by CodeFixHarness. Building an example only shows that a diagnostic fires; it never
      applies a fix, so a fix that produces code which doesn't compile went unnoticed.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The custom MSBuild task assembly, so its pure helpers can be unit tested directly instead of
      only through an end-to-end build. This is the reason the logic was moved out of an inline
      RoslynCodeTaskFactory fragment. Only the dependency-free helper type is exercised, so the
      MSBuild assemblies the task itself derives from are never loaded here.
    -->
    <ProjectReference Include="..\..\Sdk.Tasks\Sdk.Tasks.csproj" />
    <!--
      The analyzer assembly, for the same reason: its BCL-only helpers (PackageVersionElementLocator)
      are tested directly, and CodeFixHarness runs its analyzers and code fixes in-process.
    -->
    <ProjectReference Include="..\..\Sdk.Analyzers\Sdk.Analyzers.csproj" />
  </ItemGroup>

</Project>
